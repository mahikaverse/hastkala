APP_NAME=HastKala Backend
APP_VERSION=0.1.0
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Public origin of the API once deployed (no trailing slash), e.g.
# PUBLIC_BASE_URL=https://hastkala-api.onrender.com
PUBLIC_BASE_URL=
# Comma-separated allowed browser origins, or *
CORS_ORIGINS=*
# Set to True locally to load the rembg model at boot; keep False on Render
PRELOAD_AI_MODEL=True

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# Leave empty in production (there is no Ollama in the cloud).
# Local only: OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=120

GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

DEEPGRAM_API_KEY=
